{
  "name": "kient",
  "type": "module",
  "version": "1.0.1-22",
  "packageManager": "pnpm@10.12.4",
  "description": "TypeScript-First Client Library for Kick.com",
  "author": "ahmedrangel",
  "license": "MIT",
  "repository": "ahmedrangel/kient",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "pnpm --filter playground dev",
    "docs:dev": "tsup-node --config tsup-typedoc.config.ts && typedoc && vitepress dev docs",
    "docs:build": "tsup-node --config tsup-typedoc.config.ts && typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "changelog:prerelease": "changelogen --output --release --prerelease",
    "changelog:release": "changelogen --output --release",
    "prerelease": "pnpm changelog:prerelease",
    "release": "pnpm changelog:release"
  },
  "dependencies": {
    "@deepkit/type": "1.0.15",
    "cycletls": "^1.0.27",
    "exit-hook": "^4.0.0",
    "form-data": "^4.0.3",
    "ofetch": "^1.4.1",
    "pusher-js": "^8.4.0",
    "strict-event-emitter": "^0.5.1",
    "tough-cookie": "^4.1.4",
    "tseep": "^1.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@deepkit/type-compiler": "1.0.15",
    "@gjsify/esbuild-plugin-deepkit": "^0.0.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.0.10",
    "@types/tough-cookie": "^4.0.5",
    "changelogen": "^0.6.1",
    "eslint": "^9.30.1",
    "pnpm": "^10.12.4",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.7",
    "typedoc-plugin-frontmatter": "^1.3.0",
    "typedoc-plugin-markdown": "4.7.0",
    "typedoc-plugin-missing-exports": "^4.0.0",
    "typedoc-vitepress-theme": "1.1.2",
    "typescript": "5.8.3",
    "vitepress": "1.6.3"
  }
}